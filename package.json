{
  "name": "cadensumner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source for cadensumner.com",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "wrangler types && astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "unused": "knip",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "facts": "bun scripts/refresh-facts.ts",
    "assets": "node scripts/render-assets.ts",
    "verify": "bun run lint && bun run typecheck && bun run unused && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
