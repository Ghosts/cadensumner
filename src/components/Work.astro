---
import { moreProjects, projects } from "@/content/work";
import type { ResolvedFacts } from "@/facts/store";

interface Props {
  facts: ResolvedFacts;
}

const { facts } = Astro.props;
const NEW_TAB = { target: "_blank", rel: "noopener" } as const;
---

<section class="section work" id="work" aria-labelledby="work-title">
  <h2 class="visually-hidden" id="work-title">Work</h2>

  {
    projects.map((project) => (
      <article
        class="card"
        data-card
        data-palette={project.palette.join(",")}
        data-brightness="0.9"
        style={`--surface:${project.surface};--ink:${project.ink};--letters:${project.name.length}`}
      >
        <div class="top">
          <p class="identity">
            <img
              class:list={["logo", { tiled: project.logoHasTile }]}
              src={`/logos/${project.logo}`}
              alt=""
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
            />
            <span>{project.kind}</span>
          </p>
          <ul class="tags">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>

        <h3 class="display title">
          <a href={project.url} {...NEW_TAB}>
            {project.name}
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </h3>

        <div class="details">
          <p class="summary">{project.summary}</p>
          <ul class="facts">
            {project.facts.map((id) => (
              <li>
                <strong>{facts[id].text}</strong>
                <span>{facts[id].label}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }

  <ul class="more">
    {
      moreProjects.map((project) => (
        <li>
          <a href={project.url} {...NEW_TAB}>
            {project.name}
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
          <span>{project.summary}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work {
    padding-top: 12svh;
  }

  /*
   * Cards pin near the top and stack; each new one slides over the last.
   * They are tinted glass, not solid: the canvas behind takes on the project's
   * colors and shows through, so the whole screen changes with each card.
   */
  .card {
    position: sticky;
    top: 6svh;
    min-height: 84svh;
    margin-bottom: 8svh;
    padding: clamp(1.25rem, 3vw, 3rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.5rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(28px) saturate(1.5);
    color: var(--ink);
    container-type: inline-size;
    transform-origin: 50% 0;
    transform: scale(calc(1 - var(--covered, 0) * 0.06));
    filter: brightness(calc(1 - var(--covered, 0) * 0.45));
    box-shadow:
      0 -2rem 5rem -2rem rgb(0 0 0 / 0.7),
      0 0 9rem -1rem color-mix(in srgb, var(--surface) 55%, transparent);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-weight: 600;
  }

  /* Marks without their own background sit on a dark tile so they read on any card color. */
  .logo {
    width: 3.5rem;
    height: 3.5rem;
    padding: 0.55rem;
    border-radius: 0.9rem;
    background: #0a0a0c;
  }

  .logo.tiled {
    padding: 0;
    background: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .tags li {
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: 99px;
  }

  /*
   * The name fills the card width at its widest stretch. Letters average under
   * 0.9em wide there, so dividing the card width by (letters x 0.9) always fits.
   */
  .title {
    --stretch: 118;
    align-self: center;
    font-size: min(calc(100cqi / (var(--letters) * 0.9)), 13rem);
    white-space: nowrap;
  }

  .title a {
    text-decoration: none;
  }

  /* The whole card is the link target, while the link text stays the project name. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: -8px;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
  }

  .summary {
    max-width: 34ch;
    font-size: clamp(1.05rem, 1.7vw, 1.6rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem clamp(1.25rem, 3cqi, 3rem);
  }

  .facts li {
    display: grid;
    align-content: end;
    max-width: 13rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .facts strong {
    font: 900 clamp(1.9rem, 4cqi, 4rem) / 1 var(--font-display);
    font-variation-settings: "wdth" 75;
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1px;
    margin-bottom: 8svh;
    border-radius: var(--radius);
    overflow: clip;
    background: var(--line);
  }

  .more li {
    display: grid;
    gap: 0.25rem;
    padding: 1.5rem;
    background: rgb(8 7 12 / 0.9);
    color: var(--ink-soft);
  }

  .more a {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  /* With motion, each name starts condensed and widens as its card arrives. Left-aligned, so nothing shifts. */
  :global(.motion) .title {
    --stretch: 60;
    transition: font-variation-settings 0.9s var(--ease);
  }

  :global(.motion) .card:global(.is-active) .title {
    --stretch: 118;
  }
</style>
