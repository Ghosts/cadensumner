---
import { projects } from "@/content/work";
import type { ResolvedFacts } from "@/facts/store";

interface Props {
  facts: ResolvedFacts;
}

const { facts } = Astro.props;
const NEW_TAB = { target: "_blank", rel: "noopener" } as const;
---

<section class="section work" id="work" aria-labelledby="work-title">
  <h2 class="visually-hidden" id="work-title">Work</h2>

  {
    projects.map((project) => (
      <article
        class="card"
        data-card
        data-palette={project.palette.join(",")}
        data-brightness="0.9"
        style={`--surface:${project.surface};--ink:${project.ink};--letters:${project.name.length}`}
      >
        <div class="top">
          <p class="identity">
            <img
              class:list={["logo", { tiled: project.logoHasTile }]}
              src={`/logos/${project.logo}`}
              alt=""
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
            />
            <span>{project.kind}</span>
          </p>
          <ul class="tags">
            {project.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>

        <h3 class="display title">
          <a href={project.url} {...NEW_TAB}>
            <span class="visually-hidden">{project.name} (opens in a new tab)</span>
            {/* One span per letter so the name can be spread to both edges of the card. */}
            <span class="letters" aria-hidden="true">
              {[...project.name].map((letter, i) => (
                <span style={`--i:${i}`}>{letter === " " ? " " : letter}</span>
              ))}
            </span>
          </a>
        </h3>

        <div class="details">
          <p class="summary">{project.summary}</p>
          <ul class="facts">
            {project.facts.map((id) => (
              <li>
                <strong>{facts[id].text}</strong>
                <span>{facts[id].label}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</section>

<style>
  .work {
    padding-block: 12svh 4svh;
  }

  /*
   * Cards pin near the top and stack; each new one slides over the last.
   * They are tinted glass, not solid: the canvas behind takes on the project's
   * colors and shows through, so the whole screen changes with each card.
   */
  .card {
    position: sticky;
    top: 6svh;
    min-height: clamp(24rem, 62svh, 38rem);
    margin-bottom: 8svh;
    padding: clamp(1.25rem, 3vw, 3rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.5rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(28px) saturate(1.5);
    color: var(--ink);
    container-type: inline-size;
    transform-origin: 50% 0;
    transform: scale(calc(1 - var(--covered, 0) * 0.06));
    filter: brightness(calc(1 - var(--covered, 0) * 0.45));
    box-shadow:
      0 -2rem 5rem -2rem rgb(0 0 0 / 0.7),
      0 0 9rem -1rem color-mix(in srgb, var(--surface) 55%, transparent);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-weight: 600;
  }

  /* Marks without their own background sit on a dark tile so they read on any card color. */
  .logo {
    width: 3.5rem;
    height: 3.5rem;
    padding: 0.55rem;
    border-radius: 0.9rem;
    background: #0a0a0c;
  }

  .logo.tiled {
    padding: 0;
    background: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .tags li {
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: 99px;
  }

  /*
   * The name fills the card width at its widest stretch. Letters average under
   * 0.9em wide there, so dividing the card width by (letters x 0.9) always fits.
   */
  .title {
    --wide: 118;
    --letter-width: 0.9;
    --stretch: var(--wide);
    align-self: center;
    font-size: min(calc(100cqi / (var(--letters) * var(--letter-width))), 16rem);
    white-space: nowrap;
  }

  /*
   * Names differ in width, so sizing by letter count alone leaves some short of
   * the right edge. Spreading the letters makes every name span the card exactly,
   * at any stretch, so the left and right edges line up with everything else.
   */
  .letters {
    display: flex;
    justify-content: space-between;
    /* Clips the letters while they rise into place. The padding keeps the tops of the caps inside. */
    overflow: clip;
    padding-block: 0.04em;
  }

  /*
   * In a narrow card the wide cut would leave the name small. A condensed cut
   * (letters under 0.47em) fits the same width at nearly twice the size.
   */
  @container (max-width: 34rem) {
    .title {
      --wide: 60;
      --letter-width: 0.47;
    }
  }

  .title a {
    text-decoration: none;
  }

  /* The whole card is the link target, while the link text stays the project name. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: -8px;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
  }

  .summary {
    max-width: 34ch;
    font-size: clamp(1.05rem, 1.7vw, 1.6rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 1.25rem clamp(1.25rem, 3cqi, 3rem);
  }

  /* Labels are kept to a few words in the registry so they stay on one line under the number. */
  .facts li {
    display: grid;
    align-content: start;
    white-space: nowrap;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .facts strong {
    font: 900 clamp(1.9rem, 4cqi, 4rem) / 1 var(--font-display);
    font-variation-settings: "wdth" 75;
  }

  /* With motion, the letters of each name rise into place one after another as its card arrives. */
  :global(.motion) .letters span {
    transform: translateY(110%);
    transition: transform 0.7s var(--ease);
    transition-delay: calc(var(--i) * 35ms);
  }

  :global(.motion) .card:global(.is-active) .letters span {
    transform: none;
  }
</style>
