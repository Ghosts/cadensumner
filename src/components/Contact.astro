---
import { profile } from "@/content/profile";

const palette = ["#ff5a3c", "#ffd9a8", "#3b0d5c"].join(",");
---

<footer class="section contact" id="contact" data-palette={palette}>
  <h2 class="display heading">Let's talk</h2>
  <ul class="links">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.url}>{link.label}</a>
        </li>
      ))
    }
    <li>
      <a href={profile.resumePdf}>Resume (PDF)</a>
    </li>
  </ul>
  <p class="colophon">
    <a href={`${profile.repository}#readme`}>How this site is built</a>
  </p>
</footer>

<style>
  .contact {
    padding-block: 14svh 2.5rem;
    container-type: inline-size;
  }

  /* "LET'S TALK" is about 5.5em wide at this stretch; size it to fill the row on one line. */
  .heading {
    --stretch: 100;
    font-size: min(calc(100cqi / 5.7), 20rem);
    white-space: nowrap;
  }

  /* Narrow screens get the condensed cut, about 3.1em wide, at nearly twice the size. */
  @container (max-width: 34rem) {
    .heading {
      --stretch: 60;
      font-size: calc(100cqi / 3.2);
    }
  }

  .colophon {
    margin-top: 2.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .colophon a {
    text-underline-offset: 0.2em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .links a {
    display: block;
    padding: 0.8rem 1.4rem;
    border-radius: 99px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }

  .links a:hover {
    transform: translateY(-3px);
  }
</style>
